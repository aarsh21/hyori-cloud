# Active Rust backend. Keep all secrets on this process, never the web host.
APP_ENV=development
APP_ORIGIN=http://localhost:3001
# Pick an unused native-development port; the container uses private port 3002.
HYORI_SERVER_BIND=127.0.0.1:3003

# Use a fresh dedicated PostgreSQL database. No legacy importer or automatic reset exists.
HYORI_DATABASE_URL=postgres://hyori:replace-with-a-database-password@127.0.0.1:5432/hyori
# Optional pool ceiling per backend process (8 to 1024, default 48 = 128 RPC slots / 4 + 16
# upload operations). Keep the sum across replicas below PostgreSQL's max_connections (100 by default).
# HYORI_DATABASE_MAX_CONNECTIONS=48

# Independent strong operator values, not these deliberately rejected placeholders.
# Setup token: the output of `openssl rand -hex 32` (at most 256 characters). Until the first
# administrator exists, startup refuses one shorter than 32 characters or one that repeats a
# shorter text. Auth secret: at least 32 bytes.
HYORI_SETUP_TOKEN=replace-with-the-output-of-openssl-rand-hex-32
HYORI_AUTH_SECRET=replace-with-an-independent-random-auth-secret-at-least-32-characters

# Optional only for metadata-only fixtures. Omit ALL five to disable binary operations.
# Setting any requires all five. No ambient AWS credential provider is consulted.
HYORI_STORAGE_ENDPOINT=http://127.0.0.1:9000
HYORI_STORAGE_REGION=us-east-1
HYORI_STORAGE_BUCKET=hyori
HYORI_STORAGE_ACCESS_KEY=replace-with-an-independent-storage-access-key
HYORI_STORAGE_SECRET_KEY=replace-with-an-independent-storage-secret-key

# Optional: days before maintenance permanently deletes trashed items (1 to 3650, default 30).
# HYORI_TRASH_RETENTION_DAYS=30

# Optional private Unix socket for the separately isolated media worker; no decoder in the server.
# Omit to disable new processing. The complete Compose stack sets this explicitly.
# HYORI_MEDIA_WORKER_SOCKET=/run/hyori-media/worker.sock
