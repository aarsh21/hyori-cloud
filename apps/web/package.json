    "@hyori-cloud/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/router-core": "1.171.39",
    "@varlock/vite-integration": "1.5.4",
    "lucide-react": "^1.56.0",
    "next-themes": "catalog:",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "catalog:",
