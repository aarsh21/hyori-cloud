# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# Framework build mode stays static so JSX and the React runtime agree.
# @public @type=enum(development, production, test)
NODE_ENV=development

# Application deployment mode is independent of the framework's build mode.
# @public @dynamic @type=enum(development, production, test)
APP_ENV=development

# Exact external origin. The app-owned proxy validates it at initialization and fails closed with 503.
# Production requires HTTPS; the gateway must preserve its Host.
# @sensitive=false @dynamic @type=string
APP_ORIGIN=http://localhost:3001

# Private Rust HTTP(S) origin, never exposed to the browser. No credentials or URL path.
# Optional at build time; missing/invalid runtime configuration fails closed with 503.
# @sensitive=true @dynamic @required=false @type=string
HYORI_BACKEND_URL=
