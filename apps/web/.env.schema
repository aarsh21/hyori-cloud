# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# Framework build mode stays static so JSX and the React runtime agree.
# @public @type=enum(development, production, test)
NODE_ENV=development

# Application deployment mode is independent of the framework's build mode.
# @public @dynamic @type=enum(development, production, test)
APP_ENV=development

# Browser origin used for same-origin write protection.
# @sensitive=false @dynamic @type=url
APP_ORIGIN=http://localhost:3001

# Required at runtime for the protected first-admin setup, not during asset builds.
# @required=false @type=string
HYORI_SETUP_TOKEN=

# Non-secret deployment metadata is resolved at startup, not baked into SSR builds.
# Common names such as "cloud" are not secrets and must not trigger leak blocking.
# @sensitive=false @dynamic @type=url
SURREALDB_URL=http://127.0.0.1:8000
# @sensitive=false @dynamic @type=string
SURREALDB_NAMESPACE=hyori
# @sensitive=false @dynamic @type=string
SURREALDB_DATABASE=cloud
# @sensitive=false @dynamic @type=string
SURREALDB_USERNAME=root
# @required=false @type=string
SURREALDB_PASSWORD=

# @sensitive=false @dynamic @type=url
RUSTFS_ENDPOINT=http://127.0.0.1:9000
# @sensitive=false @dynamic @type=string
RUSTFS_REGION=us-east-1
# @sensitive=false @dynamic @type=string
RUSTFS_BUCKET=hyori-cloud
# @required=false @type=string
RUSTFS_ACCESS_KEY=
# @required=false @type=string
RUSTFS_SECRET_KEY=

# @sensitive=false @dynamic @type=number
DEFAULT_QUOTA_BYTES=10737418240
