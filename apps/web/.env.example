NODE_ENV=development
APP_ENV=development
APP_ORIGIN=http://localhost:3001

# Supply separate strong secrets. These placeholders are not usable credentials.
HYORI_SETUP_TOKEN=replace-with-a-long-random-setup-token
SURREALDB_URL=http://127.0.0.1:8000
SURREALDB_NAMESPACE=hyori
SURREALDB_DATABASE=cloud
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=replace-with-a-random-database-password

RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=hyori-cloud
RUSTFS_ACCESS_KEY=replace-with-a-random-access-key
RUSTFS_SECRET_KEY=replace-with-a-random-storage-secret
DEFAULT_QUOTA_BYTES=10737418240
