# Copy to a NEW .env.deployment, never over an existing environment/data directory.
# This starts a separate fresh instance. It does not import legacy accounts or objects.
APP_ENV=production
APP_ORIGIN=https://cloud.example.invalid
HYORI_WEB_PORT=3001

# Deliberately unusable placeholders, rejected by deployment-preflight and/or Rust.
# Supply independent strong values privately; do not commit real values.
POSTGRES_PASSWORD=replace-with-an-independent-postgresql-password
# URL-encode the same password above. The host is the private Compose service, not localhost.
HYORI_DATABASE_URL=postgres://hyori:replace-with-the-url-encoded-postgresql-password@postgres:5432/hyori
HYORI_SETUP_TOKEN=replace-with-a-random-setup-token-at-least-24-characters
HYORI_AUTH_SECRET=replace-with-an-independent-auth-secret-at-least-32-characters
HYORI_STORAGE_BUCKET=hyori-rust-fresh
HYORI_STORAGE_ACCESS_KEY=replace-with-an-independent-storage-access-key
HYORI_STORAGE_SECRET_KEY=replace-with-an-independent-storage-secret-key
