# Copy to a NEW .env.deployment, never over an existing environment/data directory.
# This starts a separate fresh instance. It does not import legacy accounts or objects.
APP_ENV=production
APP_ORIGIN=https://cloud.example.invalid
HYORI_WEB_PORT=3001

# Deliberately unusable placeholders, rejected by deployment-preflight and/or Rust.
# Supply independent strong values privately; do not commit real values.
POSTGRES_PASSWORD=replace-with-an-independent-postgresql-password
# URL-encode the same password above. The host is the private Compose service, not localhost.
HYORI_DATABASE_URL=postgres://hyori:replace-with-the-url-encoded-postgresql-password@postgres:5432/hyori
# Setup token: the output of `openssl rand -hex 32`. Until the first administrator exists the
# backend refuses to start with one shorter than 32 characters or one that repeats a shorter text.
HYORI_SETUP_TOKEN=replace-with-the-output-of-openssl-rand-hex-32
HYORI_AUTH_SECRET=replace-with-an-independent-auth-secret-at-least-32-characters
HYORI_STORAGE_BUCKET=hyori-rust-fresh
HYORI_STORAGE_ACCESS_KEY=replace-with-an-independent-storage-access-key
HYORI_STORAGE_SECRET_KEY=replace-with-an-independent-storage-secret-key

# Runtime hard caps, not reservations. See docs/operations.md for measurements and larger hosts.
# Swap is disabled per service: memswap_limit follows the memory cap.
HYORI_POSTGRES_CPUS=1
HYORI_POSTGRES_MEMORY=512m
HYORI_POSTGRES_PIDS=128
HYORI_RUSTFS_CPUS=1
HYORI_RUSTFS_MEMORY=2048m
HYORI_RUSTFS_PIDS=128
HYORI_BACKEND_CPUS=1.5
HYORI_BACKEND_MEMORY=512m
HYORI_BACKEND_PIDS=128
HYORI_WEB_CPUS=1
HYORI_WEB_MEMORY=512m
HYORI_WEB_PIDS=128

# Hard-linked local snapshots: one immediately, then this delay after each completed attempt.
# Keep the max age greater than interval + the expected backup duration.
HYORI_BACKUP_INTERVAL_SECONDS=86400
HYORI_BACKUP_MAX_AGE_SECONDS=90000
# One-hour hard run deadline; size for the first full copy as described in docs/backup-restore.md.
HYORI_BACKUP_TIMEOUT_SECONDS=3600
HYORI_BACKUP_KEEP=7
# Available space on the backup filesystem: integer 16-99, above the 15% low-disk alert.
# Default named volumes usually share the live-data disk; prefer a separate backup filesystem.
HYORI_BACKUP_RESERVE_PERCENT=25
HYORI_BACKUP_CPUS=0.5
HYORI_BACKUP_MEMORY=256m
HYORI_BACKUP_PIDS=64
