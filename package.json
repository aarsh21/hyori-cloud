{
  "name": "hyori-cloud",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "lint:anti-slop": "vp lint --deny-warnings",
    "test:anti-slop": "node --test tooling/anti-slop/integration.test.ts tooling/anti-slop/src/rules/*.test.ts tooling/anti-slop/src/effect/rules/*.test.ts",
    "check:tooling-types": "tsc --project tooling/tsconfig.json --noEmit",
    "check:scripts-types": "tsc --project scripts/tsconfig.json --noEmit",
    "check:source-files": "bun scripts/check-source-files.ts",
    "check:quality": "bun run lint:anti-slop && bun run ui:doctor && bun run check:source-files",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "docker:build": "docker compose --env-file .env.deployment build",
    "docker:up": "docker compose --env-file .env.deployment up -d --build",
    "docker:down": "docker compose --env-file .env.deployment down",
    "docker:logs": "docker compose --env-file .env.deployment logs -f",
    "services:up": "docker compose --env-file .env.deployment up -d --build postgres rustfs media-worker backend",
    "env:generate": "varlock codegen --path ./apps/web/",
    "rust:prepare": "cargo fetch --locked",
    "check:rust": "bun scripts/check-rust.ts",
    "test:rust-services": "bun scripts/check-rust.ts --services",
    "contracts:generate": "bun scripts/rust-contracts.ts",
    "contracts:check": "bun scripts/rust-contracts.ts --check",
    "test:contracts": "bun test scripts/generate-rust-contracts.test.ts",
    "ui:doctor": "react-doctor . --project apps/web,packages/features,packages/ui --yes --no-score --no-supply-chain --verbose --blocking error",
    "lint:architecture": "node tooling/fernando-lint/node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config --config tooling/architecture/eslint.config.ts packages/features/src packages/client-sdk/src/react packages/ui/src apps/web/src --max-warnings=0",
    "check:boundaries": "node tooling/architecture/boundaries.ts",
    "check:query": "node tooling/fernando-lint/query-gate.js tooling/architecture/query-gate.json",
    "check:artifacts": "bun --no-env-file --no-install tooling/architecture/packed-consumer.ts",
    "check:app-runtime": "bun run --cwd apps/web test:runtime",
    "test:architecture": "npm --prefix tooling/fernando-lint test && node --test tooling/architecture/profile.test.ts",
    "test": "bun test packages/api/test packages/client-sdk/tests packages/features/src apps/web/test/backend-handler.test.ts",
    "test:services": "bun run test:rust-services && bun run test:rust-sdk && bun run test:rust-upload-sdk && bun run test:rust-photos-sdk && bun run test:rust-admin-sdk && bun run test:rust-media-sdk && bun run test:rust-editors-sdk",
    "test:rust-web-host": "bun scripts/test-rust-web-host.ts",
    "test:node-proxy": "node --test packages/api/test/node-backend-proxy.test.ts",
    "test:web-image": "bun scripts/test-web-image.ts",
    "test:deployment": "bun test scripts/check-media-deployment.test.ts scripts/editor-assets-fixture.test.ts scripts/artcraft/native-clock-provenance.test.ts",
    "test:editor-static": "bun --no-env-file scripts/test-editor-static.ts",
    "test:rust-sdk": "bun scripts/test-rust-sdk.ts",
    "test:rust-image": "bun scripts/test-rust-image.ts",
    "test:rust-upload-sdk": "bun scripts/test-rust-upload-sdk.ts",
    "test:rust-photos-sdk": "bun scripts/test-rust-photos-sdk.ts",
    "test:rust-admin-sdk": "bun scripts/test-rust-admin-sdk.ts",
    "test:rust-media-sdk": "bun scripts/test-rust-media-sdk.ts",
    "test:rust-editors-sdk": "bun scripts/test-rust-editors-sdk.ts",
    "check:web": "bun scripts/check-web.ts",
    "check:dev-server": "bun run --cwd apps/web test:dev-server",
    "postinstall": "varlock codegen --path ./apps/web/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hyori-cloud/api": "workspace:*",
    "@hyori-cloud/client-sdk": "workspace:*",
    "@hyori-cloud/config": "workspace:*",
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.4",
    "@types/node": "^26.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxlint": "1.89.0",
    "playwright-core": "1.64.1",
    "react-doctor": "0.9.22",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "packageManager": "bun@1.4.4"
}
