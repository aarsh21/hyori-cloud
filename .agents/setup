#!/usr/bin/env bash
# Prepares a fresh Amp orb with the toolchains and dependencies CI uses.
# Must stay non-interactive and idempotent: stale snapshots rerun it.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  local started=$SECONDS
  echo "==> $label"
  "$@"
  echo "    $label took $((SECONDS - started))s"
}

install_system_packages() {
  local missing=()
  for package in libicu-dev libssl-dev pkg-config clang; do
    dpkg -s "$package" >/dev/null 2>&1 || missing+=("$package")
  done
  if ((${#missing[@]} == 0)); then
    echo "    already installed"
    return
  fi
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}"
}

install_bun() {
  local wanted
  wanted="$(jq -r '.packageManager | sub("^bun@"; "")' package.json)"
  if [[ "$(bun --version 2>/dev/null || true)" == "$wanted" ]]; then
    echo "    bun $wanted present"
    return
  fi
  curl -fsSL https://bun.sh/install | bash -s "bun-v$wanted"
  export PATH="$HOME/.bun/bin:$PATH"
}

install_rust() {
  if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain none --profile minimal
  fi
  export PATH="$HOME/.cargo/bin:$PATH"
  # Installs the channel and components pinned in rust-toolchain.toml.
  rustup toolchain install
  rustup show active-toolchain

  local marker="# hyori-cloud Rust toolchain"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    printf '\n%s\n[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"\n' "$marker" >>"$HOME/.bash_profile"
  fi
}

copy_env_templates() {
  # Development-only web host config; never overwrite an existing file.
  [ -f apps/web/.env ] || cp -- apps/web/.env.example apps/web/.env
}

step "System packages" install_system_packages
step "Bun" install_bun
if [[ -f rust-toolchain.toml ]]; then
  step "Rust toolchain" install_rust
  step "Cargo graph" cargo fetch --locked
fi
step "Web env file" copy_env_templates
step "Workspace dependencies" bun install --frozen-lockfile
step "Architecture checker dependencies" npm --prefix tooling/fernando-lint ci --no-audit --no-fund
