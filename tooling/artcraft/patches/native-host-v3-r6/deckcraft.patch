@@ -0,0 +1,213 @@
+/// Why the host requested native capture; only explicit manual actions may settle live editors.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeHostSaveReason {
+    /// An explicit user Save/SaveCopy action.
+    Manual,
+    /// Background capture must preserve a live editor or report busy.
+    Automatic,
+}
+
+/// Native model identity, never a backend file revision or JavaScript number.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NativeHostIdentity {
+    pub document_id: u64,
+    pub revision: u64,
+    pub dirty: bool,
+}
+
+/// Bytes produced by the engine, captured with the identity after native input settling.
+pub struct NativeHostSnapshot {
+    pub identity: NativeHostIdentity,
+    pub name: String,
+    pub bytes: Vec<u8>,
+    // Additional native snapshot witness. Never serialized as an IPC revision or pointer value.
+    guard: Box<dyn Fn(&NativeHostApp) -> bool>,
+}
+
+#[derive(Debug)]
+pub enum NativeHostFailure {
+    Busy(String),
+    IdentityChanged,
+    SerializationFailed(String),
+}
+
+impl NativeHostFailure {
+    pub fn code(&self) -> &'static str {
+        match self {
+            Self::Busy(_) => "busy",
+            Self::IdentityChanged => "identity-changed",
+            Self::SerializationFailed(_) => "serialization-failed",
+        }
+    }
+}
+
+impl std::fmt::Display for NativeHostFailure {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Busy(message) | Self::SerializationFailed(message) => formatter.write_str(message),
+            Self::IdentityChanged => formatter.write_str("The native document no longer matches the host source"),
+        }
+    }
+}
+
+impl std::error::Error for NativeHostFailure {}
+
+impl NativeHostIdentity {
+    /// Dirty is deliberately excluded: only document/revision equality identifies a snapshot.
+    pub fn same_snapshot(self, other: Self) -> bool {
+        self.document_id == other.document_id && self.revision == other.revision
+    }
+}
+
+/// Native UI intent metadata. Its ID is allocated by the frame sink, never by the parent.
+pub struct NativeHostIntent {
+    pub document_id: u64,
+    pub save_as: bool,
+    pub name: Option<String>,
+}
+
+/// Some(id) delegates to cloud; None preserves an explicitly chosen unsupported local export.
+/// Replacement never falls through to a local download. Busy must not replace an existing job.
+pub type NativeHostIntentFn = Box<dyn Fn(NativeHostIntent) -> Result<Option<String>, NativeHostFailure>>;
+
+/// A native export closure retains the exact chosen options, but accepts a renamed destination.
+/// This is a private native job, not a second IPC contract or an intercepted command callback.
+pub type NativeHostSerializer = Box<dyn Fn(&mut NativeHostApp, u64, &str, NativeHostSaveReason) -> Result<NativeHostSnapshot, NativeHostFailure>>;
+
+/// A held New/Open/Close action can run only after an exact, uncancelled durable replacement.
+pub type NativeHostContinuation = Box<dyn FnOnce(&mut NativeHostApp)>;
+
+/// The app owns chosen export options and any continuation; the frame owns captured save bytes.
+/// Cancellation drops this job, never the independent immutable snapshot or source dirty state.
+pub struct NativeHostJob {
+    pub intent_id: String,
+    pub document_id: u64,
+    pub serializer: Option<NativeHostSerializer>,
+    pub continuation: Option<NativeHostContinuation>,
+}
+
+use super::*;
+
+type NativeHostApp = crate::SlideApp;
+
+impl SlideApp {
+    /// Native committed presentation revision; no pointer address or dirty-transition heuristic.
+    pub fn native_host_identity(&self) -> Option<NativeHostIdentity> {
+        self.session.active().map(|document| NativeHostIdentity {
+            document_id: document.uid,
+            revision: document.revision,
+            dirty: document.is_dirty() || self.native_host_pending_input(),
+        })
+    }
+
+    /// Keep native IME composition and active dialogs out of background serialization.
+    pub fn native_host_pending_input(&self) -> bool {
+        self.session.active().is_some_and(|document| document.composition.is_some())
+            || self.dialog.as_ref().is_some_and(|dialog| dialog.id != "close")
+    }
+
+    /// Parse actual native presentation bytes before reporting opened to the host.
+    pub fn native_host_open(&mut self, name: &str, bytes: &[u8]) -> Result<NativeHostIdentity, NativeHostFailure> {
+        let presentation = deckcraft_engine::cmd::file::open_host_presentation(name, bytes)
+            .map_err(|error| NativeHostFailure::SerializationFailed(error.to_string()))?;
+        deckcraft_engine::cmd::file::add_opened(&mut self.session, name, Some(name.to_owned()), presentation);
+        self.native_host_identity().ok_or(NativeHostFailure::IdentityChanged)
+    }
+
+    /// Direct existing native serializer; an imported PPTX never silently turns into a copy.
+    pub fn native_host_serialize(&mut self, document_id: u64, name: &str, reason: NativeHostSaveReason) -> Result<NativeHostSnapshot, NativeHostFailure> {
+        self.native_host_serialize_options(document_id, name, reason, &json!({}))
+    }
+
+    pub(crate) fn native_host_serialize_options(&mut self, document_id: u64, name: &str, reason: NativeHostSaveReason, options: &Value) -> Result<NativeHostSnapshot, NativeHostFailure> {
+        if self.session.active().map(|document| document.uid) != Some(document_id) { return Err(NativeHostFailure::IdentityChanged) }
+        if self.dialog.is_some() || (reason == NativeHostSaveReason::Automatic && self.native_host_pending_input()) {
+            return Err(NativeHostFailure::Busy("Finish the native composition or dialog before automatic saving".into()));
+        }
+        if reason == NativeHostSaveReason::Manual {
+            self.session.settle_composition();
+        }
+        let document = self.session.active().ok_or(NativeHostFailure::IdentityChanged)?;
+        let extension = name.rsplit('.').next().unwrap_or("").to_ascii_lowercase();
+        if !matches!(extension.as_str(), "deckcraft" | "pptx" | "potx" | "ppsx" | "outline" | "txt" | "rtf" | "pdf" | "gif") {
+            return Err(NativeHostFailure::SerializationFailed("Unsupported native presentation output format".into()));
+        }
+        let bytes = match extension.as_str() {
+            "pdf" => deckcraft_engine::cmd::file::pdf_bytes(&document.doc, options),
+            "gif" => deckcraft_engine::cmd::file::gif_bytes(&document.doc, options),
+            _ => deckcraft_engine::cmd::file::save_bytes(&document.doc, &extension),
+        }.map_err(|error| NativeHostFailure::SerializationFailed(error.to_string()))?;
+        let presentation = document.doc.clone();
+        let identity = self.native_host_identity().ok_or(NativeHostFailure::IdentityChanged)?;
+        Ok(NativeHostSnapshot { identity, name: name.to_owned(), bytes,
+            guard: Box::new(move |app| app.session.active().is_some_and(|document| std::sync::Arc::ptr_eq(&document.doc, &presentation))),
+        })
+    }
+
+    /// A durable copy never retargets the original; replacement only cleans the captured revision.
+    pub fn native_host_acknowledge(&mut self, snapshot: &NativeHostSnapshot, save_as: bool) -> bool {
+        if save_as || self.native_host_pending_input() || !self.native_host_identity().is_some_and(|current| current.same_snapshot(snapshot.identity)) || !(snapshot.guard)(self) {
+            return false;
+        }
+        let Some(document) = self.session.active() else { return false };
+        let saved = document.doc.clone();
+        self.session.mark_host_saved(snapshot.identity.document_id, saved)
+    }
+
+    /// The bridge resolves System without touching slide themes, typography or document styles.
+    pub fn native_host_theme(&mut self, dark: bool) -> Result<(), NativeHostFailure> {
+        self.run("view.dark", json!({"on": dark}))
+            .map_err(NativeHostFailure::SerializationFailed)?;
+        Ok(())
+    }
+}
+
+impl SlideApp {
+    pub fn native_host_install_intents(&mut self, sink: NativeHostIntentFn) {
+        self.services.host_save = None;
+        self.native_host_intents = Some(sink);
+    }
+
+    pub(crate) fn native_host_begin_intent(&mut self, save_as: bool, name: Option<String>, serializer: Option<NativeHostSerializer>, continuation: Option<NativeHostContinuation>) -> Result<bool, NativeHostFailure> {
+        let Some(sink) = self.native_host_intents.as_ref() else { return Ok(false) };
+        if self.native_host_job.is_some() {
+            return Err(NativeHostFailure::Busy("A native save intent is already pending".into()));
+        }
+        let document_id = self.session.active().ok_or(NativeHostFailure::IdentityChanged)?.uid;
+        let Some(intent_id) = sink(NativeHostIntent { document_id, save_as, name })? else { return Ok(false) };
+        self.native_host_job = Some(NativeHostJob { intent_id, document_id, serializer, continuation });
+        Ok(true)
+    }
+
+    pub fn native_host_capture_intent(&mut self, document_id: u64, name: &str, reason: NativeHostSaveReason, intent_id: Option<&str>) -> Result<NativeHostSnapshot, NativeHostFailure> {
+        let Some(id) = intent_id else { return self.native_host_serialize(document_id, name, reason) };
+        if !self.native_host_job.as_ref().is_some_and(|job| job.intent_id == id && job.document_id == document_id) {
+            return Err(NativeHostFailure::IdentityChanged);
+        }
+        let job = self.native_host_job.take().ok_or(NativeHostFailure::IdentityChanged)?;
+        let result = match job.serializer.as_ref() {
+            Some(serialize) => serialize(self, document_id, name, reason),
+            None => self.native_host_serialize(document_id, name, reason),
+        };
+        self.native_host_job = Some(job);
+        result
+    }
+
+    pub fn native_host_cancel_intent(&mut self, id: &str) {
+        if self.native_host_job.as_ref().is_some_and(|job| job.intent_id == id) { self.native_host_job = None; }
+    }
+
+    pub fn native_host_finish_intent(&mut self, id: &str, exact_replacement: bool) {
+        if !self.native_host_job.as_ref().is_some_and(|job| job.intent_id == id) { return }
+        let Some(job) = self.native_host_job.take() else { return };
+        if exact_replacement && self.session.active().is_some_and(|document| document.uid == job.document_id)
+            && let Some(continuation) = job.continuation
+        { continuation(self); }
+    }
+
+    pub(crate) fn native_host_close_after_save(&mut self) -> Result<bool, NativeHostFailure> {
+        self.native_host_begin_intent(false, None, None, Some(Box::new(|app| {
+            if let Err(error) = app.run("file.close", json!({})) { app.host_status(error); }
+        })))
