+/// Hosted print. A sandboxed page can't show a PDF, in a child frame or a tab of its own, so the
+/// PDF is downloaded and the person prints it from their viewer. False when not hosted.
+#[allow(dead_code)] // PDF prints its own window and Deck downloads; only Word and Grid call this.
+pub fn show_pdf(bytes: &[u8]) -> Result<bool, String> {
+    if !js_requested() { return Ok(false) }
+    js_show_pdf(bytes).map(|()| true).map_err(|error| error.as_string().unwrap_or_else(|| format!("{error:?}")))
+}
+
+fn js_failure(value: JsValue) -> NativeHostFailure {
+    NativeHostFailure::SerializationFailed(value.as_string().unwrap_or_else(|| format!("{value:?}")))
+}
+
+fn field(value: &JsValue, name: &str) -> Result<JsValue, NativeHostFailure> {
+    js_sys::Reflect::get(value, &JsValue::from_str(name)).map_err(js_failure)
+}
+
+fn text(value: &JsValue, name: &str) -> Result<String, NativeHostFailure> {
+    field(value, name)?.as_string().ok_or_else(|| NativeHostFailure::SerializationFailed(format!("Missing native binding field {name}")))
+}
+
+fn optional_text(value: &JsValue, name: &str) -> Result<Option<String>, NativeHostFailure> {
+    let value = field(value, name)?;
+    if value.is_null() || value.is_undefined() { return Ok(None) }
+    value.as_string().map(Some).ok_or_else(|| NativeHostFailure::SerializationFailed(format!("Invalid native binding field {name}")))
+}
+
+fn boolean(value: &JsValue, name: &str) -> Result<bool, NativeHostFailure> {
+    field(value, name)?.as_bool().ok_or_else(|| NativeHostFailure::SerializationFailed(format!("Invalid native binding field {name}")))
+}
+
+fn native_number(value: &JsValue, name: &str) -> Result<u64, NativeHostFailure> {
+    text(value, name)?.parse().map_err(|_| NativeHostFailure::SerializationFailed(format!("Invalid native u64 field {name}")))
+}
+
+fn absent(value: &JsValue) -> bool { value.is_null() || value.is_undefined() }
+
+fn document_value(identity: Option<NativeHostIdentity>) -> JsValue {
+    identity.map(|identity| JsValue::from_str(&identity.document_id.to_string())).unwrap_or(JsValue::NULL)
+}
+
+/// Per-engine adapter implemented in the web crate. Shared frame code owns IPC and the clock.
+pub trait NativeHostAdapter {
+    fn host_identity(&self) -> Option<NativeHostIdentity>;
+    fn host_pending_input(&self) -> bool;
+    fn host_install_intents(&mut self, sink: NativeHostIntentFn);
+
+    /// None means a correlated interactive open is pending, not parsed readiness.
+    fn host_open(&mut self, name: &str, bytes: &[u8]) -> Result<Option<NativeHostIdentity>, NativeHostFailure>;
+    fn host_poll_open(&mut self) -> Result<Option<NativeHostIdentity>, NativeHostFailure>;
+
+    /// Only PDF annotations have authors; other engines leave this display-only preference alone.
+    fn host_annotation_author(&mut self, _display_name: &str) {}
+
+    fn host_capture(&mut self, document_id: u64, name: &str, reason: NativeHostSaveReason, intent_id: Option<&str>) -> Result<NativeHostSnapshot, NativeHostFailure>;
+    fn host_acknowledge(&mut self, snapshot: &NativeHostSnapshot, save_as: bool) -> Result<bool, NativeHostFailure>;
+
+    /// Called only after saved/currentRevision was posted. False must drop, never defer, the job.
+    fn host_finish_intent(&mut self, intent_id: &str, exact_replacement: bool);
+    fn host_cancel_intent(&mut self, intent_id: &str);
+
+    /// System remains an actual native preference where supported; Deck resolves it to dark/light.
+    fn host_theme(&mut self, preference: &str, resolved_dark: bool) -> Result<(), NativeHostFailure>;
