diff --git a/crates/ui-egui/src/editing/native_host.rs b/crates/ui-egui/src/editing/native_host.rs
new file mode 100644
index 0000000..d7a845e
--- /dev/null
+++ b/crates/ui-egui/src/editing/native_host.rs
@@ -0,0 +1,316 @@
+/// Why the host requested native capture; only explicit manual actions may settle live editors.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeHostSaveReason {
+    /// An explicit user Save/SaveCopy action.
+    Manual,
+    /// Background capture must preserve a live editor or report busy.
+    Automatic,
+}
+
+/// Native model identity, never a backend file revision or JavaScript number.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NativeHostIdentity {
+    pub document_id: u64,
+    pub revision: u64,
+    pub dirty: bool,
+}
+
+/// Bytes produced by the engine, captured with the identity after native input settling.
+pub struct NativeHostSnapshot {
+    pub identity: NativeHostIdentity,
+    pub name: String,
+    pub bytes: Vec<u8>,
+    // Additional native snapshot witness. Never serialized as an IPC revision or pointer value.
+    guard: Box<dyn Fn(&NativeHostApp) -> bool>,
+}
+
+#[derive(Debug)]
+pub enum NativeHostFailure {
+    Busy(String),
+    IdentityChanged,
+    SerializationFailed(String),
+}
+
+impl NativeHostFailure {
+    pub fn code(&self) -> &'static str {
+        match self {
+            Self::Busy(_) => "busy",
+            Self::IdentityChanged => "identity-changed",
+            Self::SerializationFailed(_) => "serialization-failed",
+        }
+    }
+}
+
+impl std::fmt::Display for NativeHostFailure {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Busy(message) | Self::SerializationFailed(message) => formatter.write_str(message),
+            Self::IdentityChanged => formatter.write_str("The native document no longer matches the host source"),
+        }
+    }
+}
+
+impl std::error::Error for NativeHostFailure {}
+
+impl NativeHostIdentity {
+    /// Dirty is deliberately excluded: only document/revision equality identifies a snapshot.
+    pub fn same_snapshot(self, other: Self) -> bool {
+        self.document_id == other.document_id && self.revision == other.revision
+    }
+}
+
+/// Native UI intent metadata. Its ID is allocated by the frame sink, never by the parent.
+pub struct NativeHostIntent {
+    pub document_id: u64,
+    pub save_as: bool,
+    pub name: Option<String>,
+}
+
+/// Some(id) delegates to cloud; None preserves an explicitly chosen unsupported local export.
+/// Replacement never falls through to a local download. Busy must not replace an existing job.
+pub type NativeHostIntentFn = Box<dyn Fn(NativeHostIntent) -> Result<Option<String>, NativeHostFailure>>;
+
+/// A native export closure retains the exact chosen options, but accepts a renamed destination.
+/// This is a private native job, not a second IPC contract or an intercepted command callback.
+pub type NativeHostSerializer = Box<dyn Fn(&mut NativeHostApp, u64, &str, NativeHostSaveReason) -> Result<NativeHostSnapshot, NativeHostFailure>>;
+
+/// A held New/Open/Close action can run only after an exact, uncancelled durable replacement.
+pub type NativeHostContinuation = Box<dyn FnOnce(&mut NativeHostApp)>;
+
+/// The app owns chosen export options and any continuation; the frame owns captured save bytes.
+/// Cancellation drops this job, never the independent immutable snapshot or source dirty state.
+pub struct NativeHostJob {
+    pub intent_id: String,
+    pub document_id: u64,
+    pub serializer: Option<NativeHostSerializer>,
+    pub continuation: Option<NativeHostContinuation>,
+}
+
+use super::*;
+
+type NativeHostApp = crate::PdfCraftApp;
+
+impl PdfCraftApp {
+    /// A default for future annotations, never a rewrite of the document's stored authors.
+    pub fn native_host_annotation_author(&mut self, display_name: &str) {
+        self.comment_prefs.author = display_name.to_owned();
+    }
+
+    /// Native working-file generation, not the number of saved PDF incremental revisions.
+    pub fn native_host_identity(&self) -> Option<NativeHostIdentity> {
+        let index = self.active?;
+        let view = self.views.get(index)?;
+        let document = self.session.get(view.id)?;
+        Some(NativeHostIdentity {
+            document_id: document.id.0,
+            revision: document.edit_generation(),
+            dirty: self.has_unsaved_work(index),
+        })
+    }
+
+    /// Conservatively keep a live native field/content editor out of background serialization.
+    pub fn native_host_pending_input(&self) -> bool {
+        // Print only configures output; opening it must not manufacture a document edit.
+        if (self.dialog.is_some() && !matches!(self.dialog, Some(crate::Dialog::Print)))
+            || self.password_prompt.is_some() { return true; }
+        let Some(view) = self.active.and_then(|index| self.views.get(index)) else { return false };
+        view.pending_edit.is_some()
+            || view.content.draft.is_some()
+            || view.content.blocked().is_some()
+            || view.forms.focus.is_some()
+            || view.fill_text.is_some()
+            || view.line_editor.is_some()
+    }
+
+    /// Interactive parser completion is correlated to this prompt's actual source allocation.
+    pub fn native_host_open(&mut self, name: &str, bytes: &[u8]) -> Result<Option<NativeHostIdentity>, NativeHostFailure> {
+        if self.native_host_open_pending.is_some() || self.native_host_pending_input() {
+            return Err(NativeHostFailure::Busy("Finish the current native input before opening a PDF".into()));
+        }
+        let previous = self.native_host_identity().map(|identity| identity.document_id);
+        self.open_bytes(name, None, bytes.to_vec()).map_err(NativeHostFailure::SerializationFailed)?;
+        if let Some(prompt) = self.password_prompt.as_ref() {
+            if prompt.name != name || prompt.bytes.as_slice() != bytes {
+                return Err(NativeHostFailure::IdentityChanged);
+            }
+            self.native_host_open_pending = Some(NativeHostPendingOpen { source: prompt.bytes.clone(), result: None });
+            return Ok(None);
+        }
+        let identity = self.native_host_identity().ok_or(NativeHostFailure::IdentityChanged)?;
+        if previous == Some(identity.document_id) { return Err(NativeHostFailure::IdentityChanged); }
+        Ok(Some(identity))
+    }
+
+    /// Direct native save pipeline; never invoke intercepted Save or mark_saved before durability.
+    pub fn native_host_serialize(&mut self, document_id: u64, name: &str, reason: NativeHostSaveReason) -> Result<NativeHostSnapshot, NativeHostFailure> {
+        let index = self.active.ok_or(NativeHostFailure::IdentityChanged)?;
+        let id = self.views.get(index).ok_or(NativeHostFailure::IdentityChanged)?.id;
+        if id.0 != document_id { return Err(NativeHostFailure::IdentityChanged) }
+        if self.dialog.is_some() || self.password_prompt.is_some() || (reason == NativeHostSaveReason::Automatic && self.native_host_pending_input()) {
+            return Err(NativeHostFailure::Busy("Finish the native PDF field, content edit or dialog before automatic saving".into()));
+        }
+        if !self.commit_typing_in(id) || !self.flatten_fill_sign_for_save(id) {
+            return Err(NativeHostFailure::Busy("Native PDF editing needs attention before saving".into()));
+        }
+        let bytes = self.session.save_bytes(id)
+            .map_err(|error| NativeHostFailure::SerializationFailed(error.to_string()))?;
+        self.session.check_save(id, &bytes)
+            .map_err(|error| NativeHostFailure::SerializationFailed(error.to_string()))?;
+        let identity = self.native_host_identity().ok_or(NativeHostFailure::IdentityChanged)?;
+        if identity.document_id != document_id { return Err(NativeHostFailure::IdentityChanged) }
+        let working = self.session.get(id).ok_or(NativeHostFailure::IdentityChanged)?.bytes.clone();
+        Ok(NativeHostSnapshot { identity, name: name.to_owned(), bytes: bytes.as_ref().clone(),
+            guard: Box::new(move |app| app.session.get(id).is_some_and(|document| document.edit_generation() == identity.revision && std::sync::Arc::ptr_eq(&document.bytes, &working))),
+        })
+    }
+
+    /// mark_saved replaces the current COS graph: exact PRE-apply generation is mandatory.
+    /// Its legitimate POST-apply generation bump must be reported as currentRevision by the host.
+    pub fn native_host_acknowledge(&mut self, snapshot: &NativeHostSnapshot, save_as: bool) -> Result<bool, NativeHostFailure> {
+        if save_as || self.native_host_pending_input() || !self.native_host_identity().is_some_and(|current| current.same_snapshot(snapshot.identity)) || !(snapshot.guard)(self) {
+            return Ok(false);
+        }
+        let index = self.active.ok_or(NativeHostFailure::IdentityChanged)?;
+        let id = self.views.get(index).ok_or(NativeHostFailure::IdentityChanged)?.id;
+        self.session.mark_saved(id, std::sync::Arc::new(snapshot.bytes.clone()), None)
+            .map_err(|error| NativeHostFailure::SerializationFailed(error.to_string()))?;
+        if let Some(document) = self.session.get(id) && let Some(view) = self.views.get_mut(index) {
+            view.document_changed(&document.info);
+        }
+        Ok(true)
+    }
+
+    /// Update actual native chrome, not the PDF page, document fonts or page content.
+    pub fn native_host_theme(&mut self, preference: &str) -> Result<(), NativeHostFailure> {
+        let preference = match preference {
+            "light" => crate::theme::ThemePreference::Light,
+            "dark" => crate::theme::ThemePreference::Dark,
+            "system" => crate::theme::ThemePreference::System,
+            _ => return Err(NativeHostFailure::SerializationFailed("Unknown native theme".into())),
+        };
+        self.set_theme_preference(preference);
+        Ok(())
+    }
+}
+
+pub(crate) struct NativeHostPendingOpen {
+    pub source: std::sync::Arc<Vec<u8>>,
+    pub result: Option<Result<NativeHostIdentity, NativeHostFailure>>,
+}
+
+impl PdfCraftApp {
+    pub fn native_host_install_intents(&mut self, sink: NativeHostIntentFn) {
+        self.host_save = None;
+        self.host_dirty = None;
+        self.native_host_intents = Some(sink);
+    }
+
+    pub(crate) fn native_host_save_then(&mut self, index: usize, target: SaveTarget, after: NativeHostContinuation) -> bool {
+        let result = (|| {
+            if self.native_host_job.is_some() {
+                return Err(NativeHostFailure::Busy("A native save is already awaiting its result".into()));
+            }
+            let id = self.views.get(index).ok_or(NativeHostFailure::IdentityChanged)?.id;
+            if !self.native_host_identity().is_some_and(|identity| identity.document_id == id.0) {
+                return Err(NativeHostFailure::Busy("Select the PDF being saved before requesting cloud persistence".into()));
+            }
+            let document = self.session.get(id).ok_or(NativeHostFailure::IdentityChanged)?;
+            let name = if document.name.to_ascii_lowercase().ends_with(".pdf") {
+                format!("{}.pdf", &document.name[..document.name.len() - 4])
+            } else { format!("{}.pdf", document.name) };
+            let save_as = target == SaveTarget::As;
+            let sink = self.native_host_intents.as_ref().ok_or(NativeHostFailure::IdentityChanged)?;
+            let delegated = sink(NativeHostIntent { document_id: id.0, save_as, name: save_as.then(|| name.clone()) })?;
+            let Some(intent_id) = delegated else {
+                if !save_as {
+                    return Err(NativeHostFailure::SerializationFailed("Cloud replacement cannot fall back to a local download".into()));
+                }
+                #[cfg(target_arch = "wasm32")]
+                {
+                    let snapshot = self.native_host_serialize(id.0, &name, NativeHostSaveReason::Manual)?;
+                    crate::editing::download(&snapshot.name, &snapshot.bytes).map_err(NativeHostFailure::SerializationFailed)?;
+                    // A local copy neither changes the original baseline nor runs SaveChanges.
+                    return Ok(());
+                }
+                #[cfg(not(target_arch = "wasm32"))]
+                return Err(NativeHostFailure::SerializationFailed("Browser local export is unavailable".into()));
+            };
+            self.native_host_job = Some(NativeHostJob {
+                intent_id,
+                document_id: id.0,
+                serializer: Some(Box::new(|app, document_id, name, reason| {
+                    if !name.ends_with(".pdf") {
+                        return Err(NativeHostFailure::SerializationFailed("A native PDF save must keep its selected PDF format".into()));
+                    }
+                    app.native_host_serialize(document_id, name, reason)
+                })),
+                continuation: Some(after),
+            });
+            Ok(())
+        })();
+        if let Err(error) = result { self.notify(error.to_string()); }
+        // Emitting intent is not a completed write. The frame owns the later durable result.
+        false
+    }
+
+    pub fn native_host_capture_job(&mut self, document_id: u64, name: &str, reason: NativeHostSaveReason, intent_id: Option<&str>) -> Result<NativeHostSnapshot, NativeHostFailure> {
+        let Some(intent_id) = intent_id else { return self.native_host_serialize(document_id, name, reason) };
+        if !self.native_host_job.as_ref().is_some_and(|job| job.intent_id == intent_id && job.document_id == document_id) {
+            return Err(NativeHostFailure::IdentityChanged);
+        }
+        let job = self.native_host_job.take().ok_or(NativeHostFailure::IdentityChanged)?;
+        let result = match job.serializer.as_ref() {
+            Some(serialize) => serialize(self, document_id, name, reason),
+            None => self.native_host_serialize(document_id, name, reason),
+        };
+        self.native_host_job = Some(job);
+        result
+    }
+
+    pub fn native_host_cancel_intent(&mut self, intent_id: &str) {
+        if self.native_host_job.as_ref().is_some_and(|job| job.intent_id == intent_id) {
+            self.native_host_job = None;
+        }
+    }
+
+    pub fn native_host_finish_intent(&mut self, intent_id: &str, exact_replacement: bool) {
+        if !self.native_host_job.as_ref().is_some_and(|job| job.intent_id == intent_id) { return; }
+        let Some(job) = self.native_host_job.take() else { return };
+        if exact_replacement && !self.native_host_pending_input()
+            && self.native_host_identity().is_some_and(|identity| identity.document_id == job.document_id)
+            && let Some(after) = job.continuation {
+            after(self);
+        }
+    }
+
+    pub(crate) fn native_host_password_opened(&mut self, source: &std::sync::Arc<Vec<u8>>) {
+        let identity = self.native_host_identity().ok_or(NativeHostFailure::IdentityChanged);
+        if let Some(pending) = self.native_host_open_pending.as_mut()
+            && std::sync::Arc::ptr_eq(source, &pending.source) {
+            pending.result = Some(identity);
+        }
+    }
+
+    pub(crate) fn native_host_cancel_open(&mut self, source: &std::sync::Arc<Vec<u8>>) {
+        if let Some(pending) = self.native_host_open_pending.as_mut()
+            && std::sync::Arc::ptr_eq(source, &pending.source) {
+            pending.result = Some(Err(NativeHostFailure::SerializationFailed("The requested native PDF open was cancelled".into())));
+        }
+    }
+
+    pub fn native_host_poll_open(&mut self) -> Result<Option<NativeHostIdentity>, NativeHostFailure> {
+        let Some(pending) = self.native_host_open_pending.as_mut() else { return Ok(None) };
+        if let Some(result) = pending.result.take() {
+            self.native_host_open_pending = None;
+            let opened = result?;
+            return self.native_host_identity().filter(|current| current.document_id == opened.document_id)
+                .map(Some).ok_or(NativeHostFailure::IdentityChanged);
+        }
+        let waiting = self.password_prompt.as_ref().is_some_and(|prompt| std::sync::Arc::ptr_eq(&prompt.bytes, &pending.source));
+        if !waiting {
+            self.native_host_open_pending = None;
+            return Err(NativeHostFailure::SerializationFailed("The requested native PDF open failed or was replaced".into()));
+        }
+        Ok(None)
+    }
+}
